DATABASE_URL=sqlite:////var/lib/openvpn-web/openvpn-web.sqlite
VPNCTL_PATH=/usr/local/sbin/vpnctl
VPNCTL_USE_SUDO=1
NETCTL_PATH=/usr/local/sbin/netctl
NETCTL_USE_SUDO=1
NETCTL_SUDO_USER=netctl
NETWORK_OBSERVER_ENABLED=1
NETWORK_PATHS_CONFIG_PATH=/etc/openvpn-web/network-paths.json
SERVER_ROLE_REGISTRY_PATH=/etc/openvpn-web/server-roles.json
SERVER_OBSERVER_SNAPSHOT_PATH=/var/lib/openvpn-web/server-observer/latest.json
APP_SECRET_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
OPENVPN_WEB_API_TOKEN_HASH=sha256-hex-of-api-token
OPENVPN_WEB_API_ACTOR=api:codex-local
OUT_DIR=/etc/openvpn/client-generator/output
SHARE_OUT_DIR=/mnt/antares_soft/vpn_config
ARCHIVE_DIR=/etc/openvpn/client-generator/archive
ROUTEROS_BACKUP_DIR=/var/backups/routeros
ENDPOINT_PLATFORM_ENABLED=0
ENDPOINT_PLATFORM_BASE_URL=https://endpoint.sosnadmin.local
ENDPOINT_PLATFORM_TOKEN_FILE=/etc/openvpn-web/endpoint-platform.token
ENDPOINT_PLATFORM_CA_FILE=/etc/openvpn-web/endpoint-platform-ca.pem
ENDPOINT_PLATFORM_TIMEOUT_SECONDS=5
ENDPOINT_PLATFORM_SMOKE_DEVICE_ID=
DOWNLOAD_TOKEN_TTL_MINUTES=15
