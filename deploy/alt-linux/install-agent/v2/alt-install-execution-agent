#!/bin/bash
set -Eeuo pipefail

script_path=${BASH_SOURCE[0]}
script_dir=${script_path%/*}
[[ "$script_dir" != "$script_path" ]] || script_dir=.
script_root=$(cd -- "$script_dir" && pwd -P)

if [[ -n "${ALT_INSTALL_AGENT_ROOT:-}" ]]; then
    agent_root=$ALT_INSTALL_AGENT_ROOT
else
    agent_root=$script_root
fi
if [[ -n "${ALT_INSTALL_V1_AGENT_ROOT:-}" ]]; then
    v1_agent_root=$ALT_INSTALL_V1_AGENT_ROOT
elif [[ -d "$script_root/../v1/lib" ]]; then
    v1_agent_root=$(cd -- "$script_root/../v1" && pwd -P)
else
    v1_agent_root=/usr/libexec/alt-install-agent-v1
fi

# shellcheck source=lib/config.sh
source "$agent_root/lib/config.sh"
# shellcheck source=../v1/lib/state.sh
source "$v1_agent_root/lib/state.sh"
# shellcheck source=lib/protocol.sh
source "$agent_root/lib/protocol.sh"
# shellcheck source=lib/ui.sh
source "$agent_root/lib/ui.sh"

ALT_INSTALL_RELAY_PID=

helper_verify_execution_bundle() {
    local result temporary
    result=$(state_path execution-verification.json) || return 1
    temporary="${result}.tmp.$$"
    rm -f -- "$temporary"
    if ! "$ALT_INSTALL_HELPER" verify-execution-bundle \
        --manifest "$ALT_INSTALL_STATE_ROOT/execution-bundle/execution-manifest.json" \
        --plan "$(state_path plan.json)" \
        --inventory "$(state_path inventory.json)" \
        --public-key "$ALT_INSTALL_PUBLIC_KEY" \
        --session "$(state_read session-id)" > "$temporary"; then
        rm -f -- "$temporary"
        return 1
    fi
    chmod 0600 -- "$temporary"
    mv -f -- "$temporary" "$result"
}

helper_verify_plan() {
    "$ALT_INSTALL_HELPER" verify-plan \
        --plan "$(state_path plan.json)" \
        --signature "$(state_path plan-signature.json)" \
        --public-key "$ALT_INSTALL_PUBLIC_KEY" \
        --inventory "$(state_path inventory.json)" \
        --session "$(state_read session-id)" >/dev/null
}

helper_disk_preflight() {
    "$ALT_INSTALL_HELPER" disk-preflight \
        --plan "$(state_path plan.json)" \
        --inventory "$(state_path inventory.json)" >/dev/null
}

start_execution_relay() {
    local verification deadline relay_pid ready_file ready_content ready_size
    local stop_at
    verification=$(state_path execution-verification.json) || return 1
    deadline=$(execution_json_string "$verification" expires_at) || return 1
    [[ "$deadline" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T ]] || return 1
    [[ "$ALT_INSTALL_RELAY_READY_TIMEOUT" =~ ^[0-9]+$ &&
        "$ALT_INSTALL_RELAY_READY_TIMEOUT" -ge 1 &&
        "$ALT_INSTALL_RELAY_READY_TIMEOUT" -le 60 ]] || return 1
    [[ "$ALT_INSTALL_RELAY_POLL_INTERVAL" =~ ^0\.[0-9]+$ ]] || return 1
    ready_file=$(state_path relay-ready) || return 1
    state_remove relay-ready
    [[ ! -e "$ready_file" && ! -L "$ready_file" ]] || return 1

    "$ALT_INSTALL_HELPER" serve-execution-metadata \
        --directory "$ALT_INSTALL_STATE_ROOT/execution-bundle" \
        --port 18192 \
        --deadline "$deadline" \
        --ready-file "$ready_file" >/dev/null 2>&1 &
    relay_pid=$!
    stop_at=$((SECONDS + ALT_INSTALL_RELAY_READY_TIMEOUT))
    while ((SECONDS < stop_at)); do
        if [[ -f "$ready_file" && ! -L "$ready_file" ]]; then
            ready_content=$(<"$ready_file")
            ready_size=$(wc -c < "$ready_file")
            if [[ "$ready_size" == 27 &&
                "$ready_content" == ALT_INSTALL_RELAY_READY_V1 ]] &&
                kill -0 "$relay_pid" 2>/dev/null; then
                ALT_INSTALL_RELAY_PID=$relay_pid
                break
            fi
            break
        fi
        if ! kill -0 "$relay_pid" 2>/dev/null; then
            break
        fi
        "$ALT_INSTALL_SLEEP" "$ALT_INSTALL_RELAY_POLL_INTERVAL"
    done
    if [[ "$ALT_INSTALL_RELAY_PID" != "$relay_pid" ]]; then
        kill "$relay_pid" 2>/dev/null || true
        wait "$relay_pid" || true
        state_remove relay-ready
        return 1
    fi
    if ! state_write relay-pid "$relay_pid"; then
        kill "$relay_pid" 2>/dev/null || true
        wait "$relay_pid" || true
        state_remove relay-ready
        ALT_INSTALL_RELAY_PID=
        return 1
    fi
}

stop_execution_relay() {
    if [[ -n "$ALT_INSTALL_RELAY_PID" ]]; then
        kill "$ALT_INSTALL_RELAY_PID" 2>/dev/null || true
        wait "$ALT_INSTALL_RELAY_PID" || true
    fi
    state_remove relay-pid
    state_remove relay-ready
    ALT_INSTALL_RELAY_PID=
}

agent_run() {
    config_load || terminal_hold configuration_failed
    state_init || terminal_hold state_failed
    protocol_download_execution_bundle || terminal_hold execution_pending
    helper_verify_execution_bundle ||
        terminal_hold execution_verification_failed
    protocol_claim_execution || terminal_hold execution_claim_failed

    # These checks deliberately repeat the V1 cryptographic and live-disk
    # preflight immediately before the irreversible handoff transition.
    helper_verify_plan || terminal_hold plan_verification_failed
    helper_disk_preflight || terminal_hold disk_preflight_failed
    start_execution_relay || terminal_hold relay_failed
    if ! protocol_handoff_started; then
        stop_execution_relay
        terminal_hold handoff_record_failed
    fi
}

if [[ "${ALT_INSTALL_AGENT_LIBRARY_ONLY:-0}" != 1 ]]; then
    agent_run
fi
