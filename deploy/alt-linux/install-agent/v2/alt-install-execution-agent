#!/bin/bash
set -Eeuo pipefail

script_path=${BASH_SOURCE[0]}
script_dir=${script_path%/*}
[[ "$script_dir" != "$script_path" ]] || script_dir=.
script_root=$(cd -- "$script_dir" && pwd -P)

if [[ -n "${ALT_INSTALL_AGENT_ROOT:-}" ]]; then
    agent_root=$ALT_INSTALL_AGENT_ROOT
else
    agent_root=$script_root
fi
execution_agent_root=$agent_root
if [[ -n "${ALT_INSTALL_V1_AGENT_ROOT:-}" ]]; then
    v1_agent_root=$ALT_INSTALL_V1_AGENT_ROOT
elif [[ -d "$script_root/../v1/lib" ]]; then
    v1_agent_root=$(cd -- "$script_root/../v1" && pwd -P)
else
    v1_agent_root=/usr/libexec/alt-install-agent-v1
fi
if [[ -r "$v1_agent_root/alt-install-agent" &&
    ! -L "$v1_agent_root/alt-install-agent" ]]; then
    v1_agent_entrypoint=$v1_agent_root/alt-install-agent
else
    v1_agent_entrypoint=${ALT_INSTALL_V1_AGENT_ENTRYPOINT:-/usr/libexec/alt-install-agent}
fi

[[ -f "$v1_agent_entrypoint" && ! -L "$v1_agent_entrypoint" ]] ||
    exit 1
v1_library_mode=${ALT_INSTALL_AGENT_LIBRARY_ONLY:-0}
v1_agent_root_override=${ALT_INSTALL_AGENT_ROOT-}
v1_agent_root_was_set=${ALT_INSTALL_AGENT_ROOT+x}
ALT_INSTALL_AGENT_LIBRARY_ONLY=1
unset ALT_INSTALL_AGENT_ROOT
# shellcheck source=../v1/alt-install-agent
source "$v1_agent_entrypoint"
agent_root=$execution_agent_root
ALT_INSTALL_AGENT_LIBRARY_ONLY=$v1_library_mode
if [[ -n "$v1_agent_root_was_set" ]]; then
    ALT_INSTALL_AGENT_ROOT=$v1_agent_root_override
else
    unset ALT_INSTALL_AGENT_ROOT
fi
export ALT_INSTALL_AGENT_LIBRARY_ONLY

# shellcheck source=lib/config.sh
source "$agent_root/lib/config.sh"
# shellcheck source=lib/protocol.sh
source "$agent_root/lib/protocol.sh"
# shellcheck source=lib/ui.sh
source "$agent_root/lib/ui.sh"

helper_verify_execution_bundle() {
    local result temporary
    result=$(state_path execution-verification.json) || return 1
    temporary="${result}.tmp.$$"
    rm -f -- "$temporary"
    if ! "$ALT_INSTALL_HELPER" verify-execution-bundle \
        --manifest "$ALT_INSTALL_STATE_ROOT/execution-bundle/execution-manifest.json" \
        --plan "$(state_path plan.json)" \
        --inventory "$(state_path inventory.json)" \
        --public-key "$ALT_INSTALL_PUBLIC_KEY" \
        --session "$(state_read session-id)" > "$temporary"; then
        rm -f -- "$temporary"
        return 1
    fi
    chmod 0600 -- "$temporary"
    mv -f -- "$temporary" "$result"
}

helper_verify_plan() {
    "$ALT_INSTALL_HELPER" verify-plan \
        --plan "$(state_path plan.json)" \
        --signature "$(state_path plan-signature.json)" \
        --public-key "$ALT_INSTALL_PUBLIC_KEY" \
        --inventory "$(state_path inventory.json)" \
        --session "$(state_read session-id)" >/dev/null
}

helper_disk_preflight() {
    "$ALT_INSTALL_HELPER" disk-preflight \
        --plan "$(state_path plan.json)" \
        --inventory "$(state_path inventory.json)" >/dev/null
}

bootstrap_v1_preflight() {
    local boot_id_file=${ALT_INSTALL_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}

    config_load_v2_preflight || return 1
    network_prepare || return 1
    generate_create_nonce || return 1
    helper_inventory || return 1
    if [[ -r "$boot_id_file" ]] &&
        ALT_INSTALL_BOOT_ID=$(tr -d '\r\n' < "$boot_id_file"); then
        :
    else
        return 1
    fi
    [[ "$ALT_INSTALL_BOOT_ID" =~ ^[A-Za-z0-9-]{1,128}$ ]] || return 1
    export ALT_INSTALL_BOOT_ID
    protocol_create_session "$(state_path inventory.json)" || return 1
    protocol_heartbeat agent_started || return 1
    protocol_heartbeat inventory_validated || return 1
    protocol_heartbeat waiting_for_approval || return 1
    ui_status waiting_for_approval
    protocol_wait_for_plan || return 1
    protocol_download_plan || return 1
    protocol_heartbeat plan_downloaded || return 1
    helper_verify_plan || return 1
    helper_disk_preflight || return 1
    protocol_heartbeat preflight_ready
}

stage_execution_metadata() {
    local source_root metadata_root name source temporary
    source_root="$ALT_INSTALL_STATE_ROOT/execution-bundle"
    metadata_root=${ALT_INSTALL_METADATA_ROOT:-/tmp/metadata}
    [[ "$metadata_root" == /* && "$metadata_root" != / ]] || return 1
    [[ -d "$source_root" && ! -L "$source_root" ]] || return 1
    if [[ -e "$metadata_root" ]]; then
        [[ -d "$metadata_root" && ! -L "$metadata_root" ]] || return 1
    else
        umask 077
        mkdir -p -- "$metadata_root" || return 1
        chmod 0700 -- "$metadata_root" || return 1
    fi
    for name in autoinstall.scm vm-profile.scm pkg-groups.tar install-scripts.tar; do
        source="$source_root/$name"
        [[ -f "$source" && ! -L "$source" ]] || return 1
        temporary="$metadata_root/.${name}.tmp.$$"
        rm -f -- "$temporary"
        umask 077
        cp -- "$source" "$temporary" || return 1
        chmod 0600 -- "$temporary" || return 1
        mv -f -- "$temporary" "$metadata_root/$name" || return 1
    done
}

wait_for_execution_bundle() {
    protocol_download_execution_bundle && return 0
    printf 'terminal=execution_pending\n'
    until protocol_download_execution_bundle; do
        "$ALT_INSTALL_SLEEP" 3
    done
}

agent_run() {
    config_load || terminal_hold configuration_failed
    state_init || terminal_hold state_failed
    bootstrap_v1_preflight || terminal_hold preflight_bootstrap_failed
    wait_for_execution_bundle
    helper_verify_execution_bundle ||
        terminal_hold execution_verification_failed
    protocol_claim_execution || terminal_hold execution_claim_failed

    # These checks deliberately repeat the V1 cryptographic and live-disk
    # preflight immediately before the irreversible handoff transition.
    helper_verify_plan || terminal_hold plan_verification_failed
    helper_disk_preflight || terminal_hold disk_preflight_failed
    stage_execution_metadata || terminal_hold metadata_staging_failed
    if ! protocol_handoff_started; then
        terminal_hold handoff_record_failed
    fi
    if ! protocol_installer_started; then
        terminal_hold installer_record_failed
    fi
    printf '%s\n' 'ALT install execution: verified_handoff'
}

if [[ "${ALT_INSTALL_AGENT_LIBRARY_ONLY:-0}" != 1 ]]; then
    agent_run
fi
