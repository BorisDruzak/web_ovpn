--- a/etc/rc.d/rc.sysexec
+++ b/etc/rc.d/rc.sysexec
@@ -6,5 +6,11 @@
 
 msg "INIT: Running init ($INIT)"
 
+if grep -Fqw 'sosnadmin.mode=spike' /proc/cmdline; then
+	/usr/libexec/sosnadmin-install-spike
+	while :; do
+		sleep 60
+	done
+fi
+
 # Run system init with arguments. Goodbye!
 exec runas /sbin/init /bin/environ -cf /.initrd/kernenv /sbin/sysexec "$rootmnt" "$INIT" "$@"
