# Merge explicit approved values into the existing protected environment.
# Disabled by default. Never copy passwords or tokens into tracked files.
WORKSTATIONS_ENABLED=0
WORKSTATIONS_HOST=
WORKSTATIONS_SSH_USER=altserver
# Private keys and API hash registry: openvpn-web ownership, mode 0600.
WORKSTATIONS_READ_KEY=/etc/openvpn-web/workstations/read_key
WORKSTATIONS_EXECUTE_KEY=/etc/openvpn-web/workstations/execute_key
WORKSTATIONS_KNOWN_HOSTS=/etc/openvpn-web/workstations_known_hosts
WORKSTATIONS_API_CREDENTIALS_FILE=/etc/openvpn-web/workstations/api-credentials.json
WORKSTATIONS_RECONCILE_LOCK=/var/lib/openvpn-web/workstations/reconcile.lock
